# Copy to .env and edit
BRANDPULSE_DB=data/brandpulse.db
SENTIMENT_BACKEND=vader            # vader | transformer
TRANSFORMER_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SUPPORTED_LANGUAGES=en
WINDOW_MINUTES=15
# Reddit (official API) - only needed for --source reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brandpulse-ai/0.1 (by u/your_username)
